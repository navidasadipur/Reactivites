# Copy to /opt/reactivities/.env for deployment, or deploy/local/rehearsal.env locally.
# Real values stay outside Git and the Docker build context.
REACTIVITIES_IMAGE=reactivities
REACTIVITIES_TAG=replace-with-exact-release-tag
# Generate using: openssl rand -hex 64
# Do not reuse the rehearsal key, development key, or another application's key.
REACTIVITIES_TOKEN_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
